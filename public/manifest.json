{
  "manifest_version": 3,
  "name": "FrameVault",
  "version": "0.1.0",
  "description": "Collect selected UI frames from supported design pages into a user-chosen folder.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/framevault-16.png",
    "32": "icons/framevault-32.png",
    "48": "icons/framevault-48.png",
    "128": "icons/framevault-128.png"
  },
  "permissions": ["sidePanel", "storage", "scripting"],
  "optional_host_permissions": [
    "https://www.behance.net/*",
    "https://*.behance.net/*",
    "https://dribbble.com/*",
    "https://*.dribbble.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open FrameVault",
    "default_icon": {
      "16": "icons/framevault-16.png",
      "32": "icons/framevault-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.behance.net/*",
        "https://*.behance.net/*",
        "https://dribbble.com/*",
        "https://*.dribbble.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob: https:"
  }
}
